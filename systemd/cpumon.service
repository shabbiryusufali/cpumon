[Unit]
Description=cpumon - CPU usage logger
Documentation=man:cpumon(1)
After=local-fs.target

[Service]
Type=simple
# LogsDirectory= makes systemd create /var/log/cpumon (mode 0755, owned by
# the service's User=/Group=) before ExecStart runs; log files persist
# across restarts.
LogsDirectory=cpumon

# All settings (interval, log dir/format/target, retention, compression,
# top processes, alerts) live in /etc/cpumon/cpumon.conf. Edit it, then
# `systemctl reload cpumon` - SIGHUP makes cpumon re-read the file and
# reopen its log without losing its place.
ExecStart=/usr/bin/cpumon --daemon --config /etc/cpumon/cpumon.conf
ExecReload=/bin/kill -HUP $MAINPID

# Restart automatically if it ever crashes; it otherwise loops forever.
Restart=on-failure
RestartSec=5

# Modest hardening - relax these if your environment needs to.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/cpumon
PrivateTmp=true
Nice=10

[Install]
WantedBy=multi-user.target
