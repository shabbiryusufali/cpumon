[Unit]
Description=cpumon - CPU usage logger
Documentation=man:cpumon(1)
After=local-fs.target

[Service]
Type=simple
# LogsDirectory= makes systemd create /var/log/cpumon (mode 0755, owned by
# the service's User=/Group=) before ExecStart runs, and removes it again
# only if RuntimeDirectoryPreserve isn't set - log files persist across
# restarts either way since this just controls the directory itself.
LogsDirectory=cpumon

# Defaults, overridable without touching this file: edit
# /etc/cpumon/cpumon.conf and `systemctl restart cpumon`.
Environment=CPUMON_INTERVAL=5m
Environment=CPUMON_LOG_DIR=/var/log/cpumon
Environment=CPUMON_LOG_RETENTION_DAYS=30
EnvironmentFile=-/etc/cpumon/cpumon.conf

ExecStart=/usr/bin/cpumon --daemon --interval ${CPUMON_INTERVAL} --log-dir ${CPUMON_LOG_DIR} --log-retention-days ${CPUMON_LOG_RETENTION_DAYS}

# Restart automatically if it ever crashes; it otherwise loops forever.
Restart=on-failure
RestartSec=5

# Modest hardening - relax these if your environment needs to.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/cpumon
PrivateTmp=true
Nice=10

[Install]
WantedBy=multi-user.target
